# Environment Configuration
ENV=development
LOG_LEVEL=INFO
DEBUG=True

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# LLM Configuration
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4
CLAUDE_API_KEY=your_claude_key_here
CLAUDE_MODEL=claude-opus

# Vector Database
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENVIRONMENT=your_pinecone_env
PINECONE_INDEX=formative-ai-embeddings

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/formative_ai
REDIS_URL=redis://localhost:6379

# Agent Configuration
RESEARCH_AGENT_TIMEOUT=60
DESIGN_AGENT_TIMEOUT=45
PROTOTYPE_AGENT_TIMEOUT=30
PRD_AGENT_TIMEOUT=120

# Google API
GOOGLE_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Document Generation
DOCX_TEMPLATE_PATH=/app/templates/prd_template.docx
PDF_GENERATOR=reportlab

# External Services
BACKEND_API_URL=http://localhost:3001
BACKEND_API_TIMEOUT=30

# Feature Flags
ENABLE_MULTIAGENT_ORCHESTRATION=true
ENABLE_RAG_RETRIEVAL=true
ENABLE_VALIDATION_WORKFLOW=true
